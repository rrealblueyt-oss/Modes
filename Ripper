local function getPlayerRoom()
	local currentRooms = Workspace:FindFirstChild("CurrentRooms")
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not currentRooms or not hrp then
		return nil
	end

	local roomNumber

	pcall(function()
		roomNumber = ReplicatedStorage.GameData.LatestRoom.Value
	end)

	if roomNumber then
		local room = currentRooms:FindFirstChild(tostring(roomNumber))

		if room then
			return room
		end
	end

	local closestRoom
	local closestDistance = math.huge

	for _, room in ipairs(currentRooms:GetChildren()) do
		if room:IsA("Model") then
			for _, v in ipairs(room:GetDescendants()) do
				if v:IsA("BasePart") then
					local distance = (hrp.Position - v.Position).Magnitude

					if distance < closestDistance then
						closestDistance = distance
						closestRoom = room
					end
				end
			end
		end
	end

	return closestRoom
end

local function forceRoomToRed(room)
	if not room then
		return
	end

	local red = Color3.fromRGB(255, 0, 0)

	for _, v in ipairs(room:GetDescendants()) do
		if v:IsA("BasePart") and v.Material == Enum.Material.Neon then
			v.Color = red
		end

		if v:IsA("PointLight")
			or v:IsA("SpotLight")
			or v:IsA("SurfaceLight") then
			v.Color = red
			v.Enabled = true
		end
	end
end

